# Root Docker Compose - DEVELOPMENT ONLY. Ganti password sebelum dipakai bersama.
COMPOSE_PROJECT_NAME=relawan-platform
MYSQL_DATABASE=relawan_db
MYSQL_USER=relawan_user
MYSQL_PASSWORD=ganti_password_development
MYSQL_ROOT_PASSWORD=ganti_password_root_development
MYSQL_FORWARD_PORT=3307
PHPMYADMIN_PORT=8081

# Browser-facing URL untuk Next.js. Jangan simpan secret dengan prefix NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
