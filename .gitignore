
# ==========================================================
# SECRETS & ENVIRONMENT VARIABLES
# ==========================================================
# Git
.git
.github

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*

# Dependencies
**/node_modules/
**/vendor/

# Private keys and credentials
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore


# ==========================================================
# NODE.JS / NEXT.JS (FRONTEND)
# ==========================================================
**/node_modules/
**/.next/
**/out/
**/dist/
**/.turbo/
**/.vercel/
**/coverage/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript and tooling caches
*.tsbuildinfo
.eslintcache


# ==========================================================
# PHP / LARAVEL (BACKEND)
# ==========================================================
/backend/vendor/
/backend/auth.json

# Laravel generated files
/backend/public/hot
/backend/public/build/
/backend/public/storage

/backend/storage/*.key
/backend/storage/pail

/backend/storage/logs/*
!/backend/storage/logs/.gitignore

/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore

/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore

/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore

/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore

/backend/storage/app/private/*
!/backend/storage/app/private/.gitignore

/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore

/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore

# PHPUnit
/backend/.phpunit.result.cache
/backend/.phpunit.cache
/backend/.phpunit-watcher.yml

# Laravel local development
/backend/Homestead.yaml
/backend/Homestead.json


# ==========================================================
# FLUTTER / DART & ANDROID GRADLE
# ==========================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Flutter and Android build outputs
**/build/
**/GeneratedPluginRegistrant.java
**/doc/api/

# Android Gradle and machine-specific configuration
**/.gradle/
**/local.properties
**/key.properties
**/captures/
**/.cxx/
**/.externalNativeBuild/

# Keep pubspec.yaml, pubspec.lock and .metadata in Git.


# ==========================================================
# EDITORS & OPERATING SYSTEM
# ==========================================================
.vscode/
.idea/
*.iml

.DS_Store
Thumbs.db
Desktop.ini

*.swp
*.swo
*.tmp
*.orig


# ==========================================================
# DATABASE BACKUPS & LOCAL DATA
# ==========================================================

# Backup directories
**/backups/
**/backup/
**/database/backups/

# Docker local database volumes
/docker/data/
/docker/mysql/data/

# Database backup files
*.sql.gz
*.dump
*.bak
*.backup

# Local database files
*.sqlite
*.sqlite3
*.db

# Conventional SQL backup filenames
*backup*.sql
*dump*.sql

# Keep SQL source files, schema and migrations in Git.


# ==========================================================
# DOCKER & LOCAL RUNTIME
# ==========================================================
*.pid
*.seed


# ==========================================================
# LOGS & TEMPORARY FILES
# ==========================================================
*.log

/logs/
/tmp/
/temp/
